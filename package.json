{
  "name": "interactive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "experiment:voice": "tsx experiments/voice-mcp/server.ts",
    "experiment:verify": "tsx experiments/voice-mcp/verify-inspector.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:contract": "vitest run --project contract",
    "typecheck": "tsc --noEmit",
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "tsx scripts/dev.ts --production",
    "test:browser": "playwright test",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
